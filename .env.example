# WHITE TEE — environment variables
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never contain a real value.
#
# Every variable here is server-only. Nothing in this file may ever be given a
# NEXT_PUBLIC_ prefix except the two Supabase values that already have one —
# a key reachable from the browser is a key anyone can spend.

# --- Supabase (existing) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection. Used by npm run db:migrate and images:status.
DATABASE_URL=

# --- Admin panel (existing) -------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Stripe (existing) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ----------------------------------------------------------
# Used for the shipping notice and the back-in-stock notice. Both must be set.
# Without them nothing is sent, and back-in-stock requests stay pending (they
# are never marked as notified) until email is configured.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. WHITE TEE <store@example.com>
EMAIL_FROM=
# Public origin used for links in emails, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=

# --- Claude (image pipeline: concepts, prompts, QA) -------------------------
# From platform.claude.com. Pays for the director stages, not for image
# generation.
ANTHROPIC_API_KEY=

# --- Gauge Concierge (/concierge, POST /api/concierge) ----------------------
# Uses ANTHROPIC_API_KEY above. Without a key the concierge still works: it
# answers from a deterministic rules engine and spends nothing.
#
# Model for the concierge. Defaults to claude-haiku-5-5 when unset. A
# replacement must support structured outputs (output_config.format) and the
# effort parameter; if a request is rejected the rules engine answers instead.
CONCIERGE_MODEL=claude-haiku-5-5

# Hard ceiling on paid model calls per day (Japan time). Defaults to 300 when
# unset. Past it, every request is answered by the rules engine until
# midnight JST. 0 turns the model off without removing the key. Counted in
# Supabase (supabase/migrations/add-concierge-usage.sql) when the service
# role key is set; otherwise per server process, which is weaker.
CONCIERGE_DAILY_LIMIT=300

# --- Image generation provider ----------------------------------------------
# mock | flux_bfl
# Leave as mock to run the whole pipeline offline and free. Setting a real
# provider without IMAGE_PROVIDER_API_KEY also falls back to mock, so nobody
# gets billed by forgetting a value.
IMAGE_PROVIDER=mock

# From bfl.ai. Required only when IMAGE_PROVIDER is flux_bfl.
IMAGE_PROVIDER_API_KEY=

# Optional. Shared secret BFL echoes back on webhook deliveries.
# Required (with NEXT_PUBLIC_APP_URL) before FLUX submit registers webhook_url.
IMAGE_PROVIDER_WEBHOOK_SECRET=

# --- Job runner -------------------------------------------------------------
# Bearer secret for /api/internal/images/tick. Generate with:
#   openssl rand -hex 32
# The tick endpoint is on the public internet and this is its only defence.
IMAGE_WORKER_SECRET=

# Monthly spend cap in JPY. Defaults to 20000 when unset. This is the backstop
# that stops a runaway loop, not a limit on normal use — normal months land
# well under it.
IMAGE_MONTHLY_BUDGET_JPY=20000

# How far the agent may drive the pipeline unattended.
#   off                 (default) every approval is human
#   internal_test_only  the agent may approve test-only work end to end
# There is deliberately no value that permits auto-approving production work.
IMAGE_AGENT_AUTOPILOT=off

# --- Mock knobs (development only) ------------------------------------------
# Simulated generation latency in ms.
IMAGE_MOCK_LATENCY_MS=3000
# 0.0-1.0. Injects transient failures so the retry path actually gets walked.
IMAGE_MOCK_FAILURE_RATE=0
# 0.0-1.0. Fraction of variants that fail to download within a job.
IMAGE_MOCK_PARTIAL_FAILURE_RATE=0

# --- Outbound integrations (optional) ---------------------------------------
N8N_WEBHOOK_URL=
N8N_SIGNING_SECRET=
